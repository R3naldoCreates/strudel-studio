{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strudel Studio",
  "version": "0.1.0",
  "identifier": "app.strudelstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Strudel Studio",
        "width": 1500,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#07080d"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
