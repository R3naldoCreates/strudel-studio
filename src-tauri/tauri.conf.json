{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strudel Studio",
  "version": "0.1.2",
  "identifier": "app.strudelstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Strudel Studio",
        "width": 1500,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#07080d"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob: data: https:; connect-src 'self' asset: http://asset.localhost blob: data: https: ws: wss:; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
